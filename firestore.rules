rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmapped operations
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Admin authorization check via document or verified admin email
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'zulfiqar1hasan@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // Book validation
    function isValidBook(data) {
      return data.titleBn is string && data.titleBn.size() > 0 && data.titleBn.size() <= 300
        && data.authorBn is string && data.authorBn.size() > 0 && data.authorBn.size() <= 150
        && data.priceBDT is number && data.priceBDT >= 0
        && data.isPublished is bool
        && data.categoryBn is string && data.categoryBn.size() <= 100;
    }

    // Purchase validation
    function isValidPurchase(data) {
      return data.orderId is string && data.orderId.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.bookId is string && data.bookId.size() <= 128
        && data.amountBDT is number && data.amountBDT >= 0
        && data.status in ['COMPLETED', 'PENDING', 'FAILED', 'CANCELLED']
        && data.paymentMethod == 'bKash';
    }

    // 1. Books Collection
    // Public visitors can read only published books. Admins can read all books and write.
    match /books/{bookId} {
      allow get: if isValidId(bookId) && (resource.data.isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create: if isAdmin() && isValidId(bookId) && isValidBook(incoming());
      allow update: if isAdmin() && isValidId(bookId) && isValidBook(incoming());
      allow delete: if isAdmin() && isValidId(bookId);
    }

    // 2. Purchases Collection (Verified entitlements)
    // Only the buyer or admin can read the purchase record.
    // Writes are strictly server-side / admin verified to prevent forged purchase records.
    match /purchases/{purchaseId} {
      allow get: if isValidId(purchaseId) && (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()));
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin(); // Purchase records must be recorded by server verification
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 3. User Profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId
        && incoming().keys().hasOnly(['email', 'displayName', 'createdAt', 'role'])
        && incoming().role == 'reader'; // Prevent self-elevating to admin
      allow update: if isSignedIn() && request.auth.uid == userId
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName']);
    }

    // 4. Admins collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Only manageable through Firebase Console or Cloud Functions
    }
  }
}
